# PostgreSQL — from Render dashboard (Internal Database URL)
DATABASE_URL="postgresql://user:password@host:5432/urpiece"

# Generate a strong random secret: openssl rand -hex 32
NEXTAUTH_SECRET="your-secret-here"

# Your deployed URL (no trailing slash)
NEXTAUTH_URL="https://your-app.onrender.com"

# Local uploads directory (use /tmp/uploads on Render; switch to S3/Cloudinary for persistent uploads)
UPLOAD_DIR="./public/uploads"
